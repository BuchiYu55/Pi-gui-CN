{
  "name": "pi-gui",
  "version": "0.1.6",
  "description": "Pi 桌面版 —— pi coding agent 的 Electron 图形界面（社区第三方，非官方）",
  "main": "main.js",
  "scripts": {
    "test": "node tests/smoke.mjs",
    "start": "esbuild renderer/app.js --bundle --format=iife --outfile=renderer/app.bundle.js && electron .",
    "build": "esbuild renderer/app.js --bundle --format=iife --outfile=renderer/app.bundle.js",
    "dist": "npm run build && electron-builder --win nsis"
  },
  "keywords": [
    "pi",
    "pi-coding-agent",
    "electron",
    "gui",
    "coding-agent"
  ],
  "author": "BuchiYu55",
  "license": "MIT",
  "type": "module",
  "build": {
    "appId": "io.github.buchiyu55.pi-gui",
    "productName": "Pi 桌面版",
    "directories": {
      "output": "dist-out"
    },
    "files": [
      "main.js",
      "preload.cjs",
      "renderer/index.html",
      "renderer/style.css",
      "renderer/app.js",
      "renderer/app.bundle.js",
      "extensions-builtin/**/*",
      "icon.ico",
      "skills-builtin/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Pi 桌面版",
      "include": "build/installer.nsh",
      "artifactName": "pi-gui-setup-${version}.${ext}"
    }
  },
  "devDependencies": {
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "1.2.0",
    "dompurify": "^3.4.16",
    "highlight.js": "^11.12.0",
    "marked": "^18.0.14"
  }
}
